 <Worksheet ss:Name="Paramètres">
  <Table ss:ExpandedColumnCount="2" ss:ExpandedRowCount="18" x:FullColumns="1"
   x:FullRows="1" ss:DefaultColumnWidth="60" ss:DefaultRowHeight="15">
   <Row>
    <Cell ss:StyleID="s62"><Data ss:Type="String">Paramètre</Data></Cell>
    <Cell ss:StyleID="s62"><Data ss:Type="String">Valeur</Data></Cell>
   </Row>
   <Row>
    <Cell ss:StyleID="s63"><Data ss:Type="String">Symbole</Data></Cell>
    <Cell><Data ss:Type="String">US_30</Data></Cell>
   </Row>
   <Row>
    <Cell ss:StyleID="s63"><Data ss:Type="String">Dimension</Data></Cell>
    <Cell><Data ss:Type="String">Tickflow (meanTick5s)</Data></Cell>
   </Row>
   <Row>
    <Cell ss:StyleID="s63"><Data ss:Type="String">Source</Data></Cell>
    <Cell><Data ss:Type="String">data/matrix/US_30.csv (snapshots ~1/min, heure BROKER)</Data></Cell>
   </Row>
   <Row>
    <Cell ss:StyleID="s63"><Data ss:Type="String">Historique</Data></Cell>
    <Cell><Data ss:Type="String">2026.06.28 → 2026.07.30</Data></Cell>
   </Row>
   <Row>
    <Cell ss:StyleID="s63"><Data ss:Type="String">⚠ Fenêtre</Data></Cell>
    <Cell><Data ss:Type="String">PLUS COURTE que le profil IC (OHLC 19/06→31/07) : ADX/tick/theta n'existent que dans la matrice</Data></Cell>
   </Row>
   <Row>
    <Cell ss:StyleID="s63"><Data ss:Type="String">Jours ouvrés</Data></Cell>
    <Cell><Data ss:Type="String">24</Data></Cell>
   </Row>
   <Row>
    <Cell ss:StyleID="s63"><Data ss:Type="String">Week-ends exclus</Data></Cell>
    <Cell><Data ss:Type="String">2</Data></Cell>
   </Row>
   <Row>
    <Cell ss:StyleID="s63"><Data ss:Type="String">Observations classées</Data></Cell>
    <Cell><Data ss:Type="String">482</Data></Cell>
   </Row>
   <Row>
    <Cell ss:StyleID="s63"><Data ss:Type="String">Non classées</Data></Cell>
    <Cell><Data ss:Type="String">0</Data></Cell>
   </Row>
   <Row>
    <Cell ss:StyleID="s63"><Data ss:Type="String">Séance</Data></Cell>
    <Cell><Data ss:Type="String">08:00 → 19:00, créneaux de 30 min, étiquetés par leur DÉBUT</Data></Cell>
   </Row>
   <Row>
    <Cell ss:StyleID="s63"><Data ss:Type="String">Bougie M30</Data></Cell>
    <Cell><Data ss:Type="String">dernière ligne matrice du créneau (≡ clôture)</Data></Cell>
   </Row>
   <Row>
    <Cell ss:StyleID="s63"><Data ss:Type="String">Quantité</Data></Cell>
    <Cell><Data ss:Type="String">computeMeanTick5s = moyenne de tick_count_5s_s0..s4</Data></Cell>
   </Row>
   <Row>
    <Cell ss:StyleID="s63"><Data ss:Type="String">Percentiles US_30</Data></Cell>
    <Cell><Data ss:Type="String">p25 5.4 · p50 9.4 · p75 13.6 · p95 26</Data></Cell>
   </Row>
   <Row>
    <Cell ss:StyleID="s63"><Data ss:Type="String">Règle</Data></Cell>
    <Cell><Data ss:Type="String">&lt; p25 LOW | p25–p75 MED | p75–p95 HIGH | ≥ p95 EXPLO</Data></Cell>
   </Row>
   <Row>
    <Cell ss:StyleID="s63"><Data ss:Type="String">⚠ Autre échelle</Data></Cell>
    <Cell><Data ss:Type="String">classifyTickflow (DEAD/OFF/OK/HIGH/HOT/BURST) est une échelle DIFFÉRENTE, sur d'autres percentiles</Data></Cell>
   </Row>
   <Row>
    <Cell ss:StyleID="s63"><Data ss:Type="String">⚠ Saisonnalité</Data></Cell>
    <Cell><Data ss:Type="String">le tick est saisonnier : η² ≈ 0,55 sur US_30 (part de variance expliquée par l'HEURE seule)</Data></Cell>
   </Row>
   <Row>
    <Cell ss:StyleID="s63"><Data ss:Type="String">Seuils</Data></Cell>
    <Cell><Data ss:Type="String">importés du moteur, jamais recopiés</Data></Cell>
   </Row>
  </Table>
