<Row><Cell ss:StyleID="sLbl"><Data ss:Type="String">Source</Data></Cell><Cell><Data ss:Type="String">data/matrix/US_30.csv (snapshots ~1/min, heure BROKER)</Data></Cell></Row>
<Row><Cell ss:StyleID="sLbl"><Data ss:Type="String">Historique</Data></Cell><Cell><Data ss:Type="String">2026.06.29 → 2026.07.30</Data></Cell></Row>
<Row><Cell ss:StyleID="sLbl"><Data ss:Type="String">⚠ Fenêtre</Data></Cell><Cell><Data ss:Type="String">PLUS COURTE que le profil IC (OHLC 19/06→31/07) : ADX/tick/theta n'existent que dans la matrice</Data></Cell></Row>
<Row><Cell ss:StyleID="sLbl"><Data ss:Type="String">Jours ouvrés</Data></Cell><Cell><Data ss:Type="String">24</Data></Cell></Row>
<Row><Cell ss:StyleID="sLbl"><Data ss:Type="String">Week-ends exclus</Data></Cell><Cell><Data ss:Type="String">0</Data></Cell></Row>
<Row><Cell ss:StyleID="sLbl"><Data ss:Type="String">Observations classées</Data></Cell><Cell><Data ss:Type="String">490</Data></Cell></Row>
<Row><Cell ss:StyleID="sLbl"><Data ss:Type="String">Non classées</Data></Cell><Cell><Data ss:Type="String">0</Data></Cell></Row>
<Row><Cell ss:StyleID="sLbl"><Data ss:Type="String">Séance</Data></Cell><Cell><Data ss:Type="String">08:00 → 19:00, créneaux de 30 min, étiquetés par leur DÉBUT</Data></Cell></Row>
<Row><Cell ss:StyleID="sLbl"><Data ss:Type="String">Bougie M30</Data></Cell><Cell><Data ss:Type="String">dernière ligne matrice du créneau (≡ clôture)</Data></Cell></Row>
<Row><Cell ss:StyleID="sLbl"><Data ss:Type="String">Colonne source</Data></Cell><Cell><Data ss:Type="String">adx14_h1_c1 (dernière CLÔTURE H1, ≡ adxClose)</Data></Cell></Row>
<Row><Cell ss:StyleID="sLbl"><Data ss:Type="String">Bandes ADX_BANDS</Data></Cell><Cell><Data ss:Type="String">16 · 24 · 33 · 55</Data></Cell></Row>
<Row><Cell ss:StyleID="sLbl"><Data ss:Type="String">Règle</Data></Cell><Cell><Data ss:Type="String">≥55 EXTREME_HIGH · ≥33 HIGH · ≥24 MEDIUM · ≥16 LOW · sinon EXTREME_LOW</Data></Cell></Row>
<Row><Cell ss:StyleID="sLbl"><Data ss:Type="String">Note</Data></Cell><Cell><Data ss:Type="String">bandes équiréparties en POPULATION, pas en amplitude — et indépendantes du TF</Data></Cell></Row>
<Row><Cell ss:StyleID="sLbl"><Data ss:Type="String">Seuils</Data></Cell><Cell><Data ss:Type="String">importés du moteur, jamais recopiés</Data></Cell></Row>
